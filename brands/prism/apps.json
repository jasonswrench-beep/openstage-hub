{
  "_about": "The fixed facts about each app that GitHub cannot tell the catalog script: its mark, how Windows lists it, its program file and its installer's quiet switch. Update Prism Catalog.bat adds each app's newest stable and preview release (address, SHA-256, size) and writes the signed catalog. The icon each mark names (in this folder) goes into the signed catalog as a picture. docs/catalog.md explains every field.",
  "minimumHubVersion": "1.0.0",
  "hub": {
    "repository": "jasonswrench-beep/prism-hub",
    "setupPattern": "^Prism-Hub-.*-Setup\\.exe$"
  },
  "apps": [
    {
      "id": "prismqda",
      "name": "PrismQDA",
      "mark": { "letters": "qd", "color": "#5B45E0", "icon": "icons/prismqda.svg" },
      "description": "Qualitative and mixed-methods analysis",
      "repository": "jasonswrench-beep/prismqda",
      "installedAs": "PrismQDA",
      "programFile": "prismqda-app.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^PrismQDA_.*_x64-setup\\.exe$",
      "extras": [
        { "name": "Portable copy", "description": "Runs without installing", "pattern": "^PrismQDA_.*_portable\\.zip$" }
      ]
    },
    {
      "id": "prismstatistics",
      "name": "PrismStatistics",
      "mark": { "letters": "st", "color": "#2F64D6", "icon": "icons/prismstatistics.svg" },
      "description": "Statistics for research and teaching",
      "repository": "jasonswrench-beep/prism_statistics",
      "installedAs": "PrismStatistics",
      "programFile": "prismstatistics-app.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^PrismStatistics_.*_x64-setup\\.exe$"
    },
    {
      "id": "prism-reference-manager",
      "name": "Prism Reference Manager",
      "mark": { "letters": "rm", "color": "#4B5FA8", "icon": "icons/prism-reference-manager.svg" },
      "description": "Collect, read and cite sources",
      "repository": "jasonswrench-beep/prism_reference_manager",
      "installedAs": "Prism Reference Manager",
      "programFile": "prism-reference-manager.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^Prism-Reference-Manager-.*-setup\\.exe$",
      "extras": [
        { "name": "Portable copy", "description": "Runs without installing", "pattern": "^Prism-Reference-Manager-.*-portable\\.zip$" },
        { "name": "Browser add-on", "description": "Saves pages and PDFs from your browser into the library", "pattern": "^Prism-Reference-Manager-.*-browser-capture\\.zip$" }
      ]
    },
    {
      "id": "prism-transcribe",
      "name": "Prism Transcribe",
      "mark": { "letters": "tr", "color": "#7A2FD0", "icon": "icons/prism-transcribe.svg" },
      "description": "Transcripts of interviews and focus groups",
      "repository": "jasonswrench-beep/prism_transcription",
      "installedAs": "Prism Transcribe",
      "programFile": "prism-transcribe.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^Prism-Transcribe_.*_x64-setup\\.exe$"
    },
    {
      "id": "prismsurvey",
      "name": "Prism Survey",
      "mark": { "letters": "ps", "color": "#285BFC", "icon": "icons/prismsurvey.svg" },
      "description": "Scales from published measures, ready for Word questionnaires",
      "repository": "jasonswrench-beep/prism_survey",
      "installedAs": "Prism Survey",
      "programFile": "prismsurvey-app.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^Prism[-. _]Survey_.*_x64-setup\\.exe$"
    }
  ],
