{
  "_about": "The fixed facts about each app that GitHub cannot tell the catalog script: its mark, how Windows lists it, its program file and its installer's quiet switch. Update OpenStage Catalog.bat adds each app's newest stable and preview release (address, SHA-256, size) and writes the signed catalog. The icon each mark names (in this folder) goes into the signed catalog as a picture. docs/catalog.md explains every field.",
  "minimumHubVersion": "1.0.0",
  "alsoPublishIconFiles": true,
  "_alsoPublishIconFiles": "OpenStage Hub 1.0.1 reads each app's icon as a separate PNG file beside the catalog; 1.0.2 and later read it inside the catalog. While 1.0.1 hubs are still about, the script publishes both, so their icons stay. Remove this once 1.0.2 has been out long enough for installed hubs to have updated.",
  "hub": {
    "repository": "jasonswrench-beep/openstage-hub",
    "setupPattern": "^OpenStage-Hub-.*-Setup\\.exe$"
  },
  "apps": [
    {
      "id": "openstage-author",
      "name": "OpenStage Author",
      "mark": { "letters": "au", "color": "#5B3FC4", "icon": "icons/openstage-author.png" },
      "description": "The main authoring studio",
      "repository": "jasonswrench-beep/openstage-author",
      "installedAs": "OpenStage Author",
      "programFile": "openstage-editor.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage-Author.*[Ss]etup\\.exe$"
    },
    {
      "id": "openstage-recorder",
      "name": "OpenStage Recorder",
      "mark": { "letters": "re", "color": "#B42318", "icon": "icons/openstage-recorder.png" },
      "description": "A light screen recorder with a simple editor",
      "repository": "jasonswrench-beep/openstage-recorder",
      "installedAs": "OpenStage Recorder",
      "programFile": "openstage-recorder.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage[-.]Recorder.*[Ss]etup\\.exe$",
      "extras": [
        { "name": "Portable copy", "description": "Runs without installing", "pattern": "^OpenStage-Recorder.*portable\\.zip$" }
      ]
    },
    {
      "id": "openassess",
      "name": "OpenAssess",
      "mark": { "letters": "as", "color": "#0F7B6C", "icon": "icons/openassess.png" },
      "description": "Turns test banks into LMS-ready quizzes",
      "repository": "jasonswrench-beep/openstage-assess",
      "installedAs": "OpenAssess",
      "programFile": "openassess-shell.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenAssess.*[Ss]etup\\.exe$"
    },
    {
      "id": "openexplainer",
      "name": "OpenExplainer",
      "mark": { "letters": "ex", "color": "#6B5BD2", "icon": "icons/openexplainer.png" },
      "description": "Still-image tutorials and how-to books",
      "repository": "jasonswrench-beep/OpenExplainer",
      "installedAs": "OpenExplainer",
      "programFile": "openexplainer.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenExplainer.*[Ss]etup\\.exe$",
      "ignoreTags": ["v0.1.1", "v0.1.0"],
      "_ignoreTags": "Published before code signing began (OpenExplainer signs from 0.2.0 alpha 3), so the hub cannot install them. Remove a tag here if that release is re-published signed."
    },
    {
      "id": "openstage-capture-express",
      "name": "OpenStage Capture Express",
      "mark": { "letters": "ce", "color": "#B54708", "icon": "icons/openstage-capture-express.png" },
      "description": "Step-by-step guide maker",
      "repository": "jasonswrench-beep/openstage-capture-express",
      "installedAs": "OpenStage Capture Express",
      "programFile": "openstage-capture-express.exe",
      "quietSwitch": ["/SILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/CURRENTUSER"],
      "quietUninstallSwitch": ["/SILENT", "/SUPPRESSMSGBOXES"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage-Capture-Express.*[Ss]etup\\.exe$"
    },
    {
      "id": "openstage-guide",
