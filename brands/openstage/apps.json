    },
    {
      "id": "openstage-studio",
      "name": "OpenStage Studio",
      "mark": { "letters": "st", "color": "#0E6E8C", "icon": "icons/openstage-studio.png" },
      "description": "Narrated, captioned tutorial videos from a script",
      "repository": "jasonswrench-beep/OpenStage_Studio",
      "installedAs": "OpenStage Studio",
      "programFile": "openstage-studio.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage[-. _]Studio.*[Ss]etup\\.exe$",
      "listedBeforeRelease": true,
      "_listedBeforeRelease": "Listed under Desktop now (Jason's choice, 2026-11-17), its row reading No release yet with no Install button, until its repository is public with a published, signed release; from then on the catalog script lists that release and Install appears, with no change here."
    },
    {
      "id": "openstage-package-doctor",
