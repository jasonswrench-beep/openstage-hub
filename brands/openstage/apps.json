      "installedAs": "OpenStage Rehearse",
      "programFile": "openstage-rehearse.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage[-. _]Rehearse.*[Ss]etup\\.exe$",
      "hiddenUntilRepositoryExists": true,
      "comingSoonUntilReleased": true,
      "_hiddenUntilRepositoryExists": "Left out of the catalog until the repository exists (private is enough), then listed under Coming soon until it is public with a signed release. The program file and quiet switch are what a Tauri app made like the others would have; check them when its first release is made."
    }
