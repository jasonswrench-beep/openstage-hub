      "repository": "jasonswrench-beep/openstage-package-doctor",
      "installedAs": "OpenStage Package Doctor",
      "programFile": "openstage-package-doctor.exe",
      "quietSwitch": ["/P"],
      "expectedSigner": "Jason Wrench",
      "setupPattern": "^OpenStage[-. _]Package[-. _]Doctor.*[Ss]etup\\.exe$",
      "listedBeforeRelease": true,
      "_listedBeforeRelease": "As for OpenStage Studio. The program file and quiet switch are what a Tauri app made like the others would have; check them when its first release is made."
    },
